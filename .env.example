# Clerk browser key; production-only until the instance is claimed in P9.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk server key; production-only until the instance is claimed in P9.
CLERK_SECRET_KEY=

# Set to true only after Google and GitHub OAuth are configured in Clerk.
NEXT_PUBLIC_ENABLE_OAUTH=

# Clerk JWT issuer configured in the Convex deployment environment.
CLERK_JWT_ISSUER_DOMAIN=

# Convex deployment identifier used by local CLI commands.
CONVEX_DEPLOYMENT=

# Convex deployment URL consumed by the browser client.
NEXT_PUBLIC_CONVEX_URL=

# Convex HTTP-actions URL reserved for the P8 API work.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Transitional Supabase data variables remain until their pending P6 removal.
# Supabase project URL from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous client key from the project's API settings.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq API key created in the Groq developer console.
GROQ_API_KEY=
